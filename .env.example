# =============================================================================
# karyaNovel - Environment Configuration Template (.env.example)
# Salin file ini menjadi .env pada direktori root dan sesuaikan nilai konfigurasinya
# =============================================================================

# Pengaturan Aplikasi
APP_NAME=karyaNovel
APP_ENV=development
APP_KEY=
APP_URL=http://localhost/Novelweb

# Pengaturan Database MySQL (Default XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karyanovel_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Konfigurasi AI Writing Assistant & Chatbot
AI_PROVIDER=custom
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=30
AI_MAX_PROMPT_LENGTH=2000

# Konfigurasi Notifikasi WhatsApp Gateway (Fonnte)
# Daftar dan peroleh API Key di https://fonnte.com
FONNTE_API_KEY=YOUR_FONNTE_API_KEY_HERE
FONNTE_TARGET_PHONE=081234567890
FONNTE_ENABLED=true
FONNTE_NOTIFY_NEW_NOVEL=true
FONNTE_NOTIFY_NEW_CHAPTER=true
FONNTE_NOTIFY_SYSTEM=true
